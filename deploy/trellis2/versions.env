# Pixal3D builds on the TRELLIS.2 image. Its source is the revision the 4090's
# beyond-canvas/pixal3d:f7cf384 image was built from; NAF is the torch.hub
# upsampler it loads, pinned when the DGX Spark build was made.
PIXAL3D_SOURCE_REVISION=f7cf38429b0bd264f1995f0f8743a88b1c728b94
NAF_REVISION=37f2dfc180f2de53d98bd601109c0da0dd6b0f43
